[Unit]
Description=palmrest: Magic Mouse gestures (scroll, swipes, double-taps)
Documentation=https://github.com/PoHsuanLai/palmrest
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Root-owned: the input service serves only the genuine palmrest file, so nothing the user can overwrite runs here.
ExecStart=/usr/local/bin/palmrest
# Library-path variables from the user manager are not passed on, so no library of the user's own is loaded into this service.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
